        },
        "action": {
            "type": "block"
        }
    },
    {
        "trigger": {
            "url-filter": ".*(scorecardresearch\\.com|quantserve\\.com|chartbeat\\.com).*"
        },
        "action": {
            "type": "block"
        }
    },
    {
        "trigger": {
            "url-filter": ".*(criteo\\.com|criteo\\.net|taboola\\.com|outbrain\\.com|adnxs\\.com|rubiconproject\\.com|pubmatic\\.com|openx\\.net|casalemedia\\.com).*"
        },
